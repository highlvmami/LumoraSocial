# Sunucu portu
PORT=3000

# Oturum çerezlerini imzalamak için uzun, rastgele bir değer
SESSION_SECRET=buraya-uzun-rastgele-bir-deger-yazin

# İlk yönetici kaydı için gizli anahtar (KEY).
# "Admin girişi" > "İlk yönetici kaydı" ekranında bu değer istenir.
# Yalnızca BİR KEZ kullanılabilir: ilk yönetici oluşturulduktan sonra kayıt ekranı kapanır.
ADMIN_SETUP_KEY=

# Veritabanı dosyası ve yüklenen resimlerin klasörü
DB_PATH=data/lumora.db
UPLOADS_DIR=data/uploads

# Canlı ortamda (HTTPS arkasında) production yapın
NODE_ENV=development

# Sitenin dışarıdan erişilen adresi (e-postadaki bağlantılar ve sosyal giriş dönüşleri bununla kurulur)
APP_URL=http://localhost:3000

# ---- E-posta (SMTP) — boş bırakılırsa e-postalar sunucu penceresine yazılır ----
# Örnek (Gmail): SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=adres@gmail.com, SMTP_PASS=uygulama-şifresi
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=LumoraSocial <no-reply@ornek.com>

# ---- SMS (Twilio) — boş bırakılırsa SMS kodları sunucu penceresine yazılır ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- Sosyal giriş — anahtarı girilmeyen sağlayıcının butonu görünmez ----
# Dönüş adresi (Redirect/Callback URL): APP_URL + /auth/google/callback (github için de aynı şekilde)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
