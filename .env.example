# Sunucu portu
PORT=3000

# Oturum çerezlerini imzalamak için uzun, rastgele bir değer
SESSION_SECRET=buraya-uzun-rastgele-bir-deger-yazin

# İlk yönetici kaydı için gizli anahtar (KEY).
# "Admin girişi" > "İlk yönetici kaydı" ekranında bu değer istenir.
# Yalnızca BİR KEZ kullanılabilir: ilk yönetici oluşturulduktan sonra kayıt ekranı kapanır.
ADMIN_SETUP_KEY=

# Veritabanı dosyası ve yüklenen resimlerin klasörü
DB_PATH=data/lumora.db
UPLOADS_DIR=data/uploads

# Bulut veritabanı (Turso). Doldurulursa üyeler, paylaşımlar ve fotoğraflar Turso'da tutulur;
# sunucu diski silinse (ör. Render ücretsiz plan) bile veriler kaybolmaz. Boşsa yerel dosya kullanılır.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Canlı ortamda (HTTPS arkasında) production yapın
NODE_ENV=development

# Sitenin dışarıdan erişilen adresi (e-postadaki bağlantılar ve sosyal giriş dönüşleri bununla kurulur)
APP_URL=http://localhost:3000

# ---- E-posta (SMTP) — boş bırakılırsa e-postalar sunucu penceresine yazılır ----
# Örnek (Gmail): SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=adres@gmail.com, SMTP_PASS=uygulama-şifresi
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=LumoraSocial <no-reply@ornek.com>

# Gmail API ile gönderim (önerilen, ücretsiz): Google Cloud'da Gmail API'yi açıp Masaüstü türünde OAuth istemcisi oluşturun,
# kimlikleri girip 'npm run gmail-izni' çalıştırın; GMAIL_REFRESH_TOKEN otomatik yazılır. MAIL_FROM o Gmail adresi olmalı.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Render ücretsiz planı SMTP portlarını kapatır; orada Brevo kullanın (brevo.com, günde 300 e-posta ücretsiz).
# BREVO_API_KEY doluysa SMTP ayarları yerine Brevo kullanılır. Gönderen adres MAIL_FROM, Brevo'da doğrulanmış olmalı.
BREVO_API_KEY=

# ---- SMS (Twilio) — boş bırakılırsa SMS kodları sunucu penceresine yazılır ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- Sosyal giriş — anahtarı girilmeyen sağlayıcının butonu görünmez ----
# Dönüş adresi (Redirect/Callback URL): APP_URL + /auth/google/callback (github için de aynı şekilde)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Fotoğraf denetimi (Sightengine, ücretsiz: ayda 2000 fotoğraf). Boşsa fotoğraflar denetlenmez.
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=
